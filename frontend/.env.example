# ── Site identity ───────────────────────────────────────────────────────────
VITE_APP_NAME="SWAN Abuja Chapter"
VITE_SITE_TAGLINE="Society of Women Accountants of Nigeria, Abuja Chapter"
VITE_CONTACT_EMAIL=contact@swanabujachapter.com
VITE_CONTACT_PHONE="0803 450 2401"
VITE_CONTACT_ADDRESS="Abuja, Federal Capital Territory, Nigeria"
VITE_API_URL=http://localhost:8001

# ── Brand palette ───────────────────────────────────────────────────────────
# These are the only three colour sources used by the UI. Lighter borders and
# muted surfaces are transparent mixes of these same colours, never extra hues.
# Restart the dev server after editing because Vite reads them at build time.
VITE_PRIMARY_COLOR=#000066
VITE_SECONDARY_COLOR=#FFFF00
VITE_TERTIARY_COLOR=#FFFFFF

# Corner radius for cards, inputs and buttons.
VITE_BRAND_RADIUS=0.375rem
