# ── Site identity ───────────────────────────────────────────────────────────
VITE_APP_NAME="SWAN Abuja Chapter"
VITE_SITE_TAGLINE="Society of Women Accountants of Nigeria, Abuja Chapter"
VITE_CONTACT_EMAIL=contact@swanabujachapter.com
VITE_CONTACT_PHONE="0803 450 2401"
VITE_CONTACT_ADDRESS="Abuja, Federal Capital Territory, Nigeria"

# ── Brand colour tokens ─────────────────────────────────────────────────────
# Change a value here and the whole site follows. Any CSS colour is valid
# (hex, rgb(), oklch()). Restart the dev server after editing — Vite reads
# these at build time, not at runtime.

# Purple ramp: 900 is the darkest ink, 050 the lightest wash.
VITE_BRAND_PURPLE_900=#2C1250
VITE_BRAND_PURPLE_800=#3D1A6B
VITE_BRAND_PURPLE_700=#5A2D91
VITE_BRAND_PURPLE_500=#7C4DBE
VITE_BRAND_PURPLE_200=#DDD0EF
VITE_BRAND_PURPLE_050=#F4EEFB

# Gold ramp, used for rules, accents and member-tier marks.
VITE_BRAND_GOLD_700=#8F6A17
VITE_BRAND_GOLD_500=#B8892B
VITE_BRAND_GOLD_300=#E5C76B
VITE_BRAND_GOLD_050=#FBF4E2

# Neutrals and state colours.
VITE_BRAND_PAPER=#FAF8FC
VITE_BRAND_INK=#1B1024
VITE_BRAND_SUCCESS=#1F6F43
VITE_BRAND_DANGER=#B3261E

# Dark-mode surfaces.
VITE_BRAND_DARK_BG=#150C1E
VITE_BRAND_DARK_SURFACE=#1E1229
VITE_BRAND_DARK_PRIMARY=#B58CE6

# Corner radius for cards, inputs and buttons.
VITE_BRAND_RADIUS=0.375rem
